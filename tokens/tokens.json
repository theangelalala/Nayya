{
  "color": {
    "$type": "color",
    "primary": {
      "50":  { "$value": "#F1F5F7" },
      "100": { "$value": "#A8BECB" },
      "200": { "$value": "#648393" },
      "400": { "$value": "#3F5764" },
      "600": { "$value": "#223C45" },
      "900": { "$value": "#0F232A" }
    },
    "neutral": {
      "0":   { "$value": "#FFFFFF" },
      "25":  { "$value": "#FBFBFB" },
      "50":  { "$value": "#FCFBF9" },
      "100": { "$value": "#F3F2F1" },
      "200": { "$value": "#E7E5E3" },
      "300": { "$value": "#D8D5D2" },
      "400": { "$value": "#BCB8B5" },
      "500": { "$value": "#9A9692", "$description": "Fails AA as text on light surfaces. Disabled and placeholder text only." },
      "600": { "$value": "#625D59" },
      "700": { "$value": "#463F3C" },
      "800": { "$value": "#2D2A28" },
      "900": { "$value": "#1E1C1B" },
      "950": { "$value": "#1A1A1A" }
    },
    "error": {
      "100": { "$value": "#FADBD6" },
      "600": { "$value": "#D53119" }
    },
    "success": {
      "100": { "$value": "#D0EEDF" },
      "600": { "$value": "#15A961", "$description": "Fills and icons only. Use success.800 for text." },
      "800": { "$value": "#0E7A45" }
    },
    "warning": {
      "100": { "$value": "#FEEFD4" },
      "600": { "$value": "#E19405", "$description": "Fills and icons only. Use warning.900 for text." },
      "900": { "$value": "#A97412" }
    },
    "chart": {
      "blue":  { "$value": "#5D819E" },
      "green": { "$value": "#559E7F" }
    }
  },

  "surface": {
    "$type": "color",
    "page":         { "$value": "{color.neutral.25}",  "$description": "App background" },
    "default":      { "$value": "{color.neutral.0}",   "$description": "Cards, modals" },
    "subtle":       { "$value": "{color.neutral.100}", "$description": "Secondary panels, table stripes" },
    "brand":        { "$value": "{color.primary.600}", "$description": "Brand blocks" },
    "brand-subtle": { "$value": "{color.primary.50}",  "$description": "Highlighted cards, selected rows" },
    "inverse":      { "$value": "{color.neutral.950}", "$description": "Dark tooltips, banners" },
    "overlay":      { "$value": "#2D2A2899",           "$description": "Modal scrim (neutral.800 at 60%)" }
  },
  "text": {
    "$type": "color",
    "primary":   { "$value": "{color.neutral.950}" },
    "secondary": { "$value": "{color.neutral.600}" },
    "disabled":  { "$value": "{color.neutral.500}", "$description": "Disabled and placeholder text only" },
    "inverse":   { "$value": "{color.neutral.25}",  "$description": "Text on dark or brand surfaces" },
    "brand":     { "$value": "{color.primary.600}", "$description": "Links, emphasis" },
    "error":     { "$value": "{color.error.600}" },
    "success":   { "$value": "{color.success.800}" },
    "warning":   { "$value": "{color.warning.900}" }
  },
  "border": {
    "$type": "color",
    "subtle":  { "$value": "{color.neutral.200}", "$description": "Dividers" },
    "default": { "$value": "{color.neutral.400}", "$description": "Inputs, cards" },
    "strong":  { "$value": "{color.neutral.950}", "$description": "Selected or emphasized items" },
    "focus":   { "$value": "{color.primary.400}", "$description": "Focus ring" },
    "error":   { "$value": "{color.error.600}" }
  },
  "action": {
    "$type": "color",
    "primary":       { "$value": "{color.primary.600}" },
    "primary-hover": { "$value": "{color.primary.900}" },
    "secondary":     { "$value": "{color.neutral.0}", "$description": "Pair with border.strong" },
    "disabled":      { "$value": "{color.neutral.200}" }
  },
  "status": {
    "$type": "color",
    "error-subtle":   { "$value": "{color.error.100}" },
    "success-subtle": { "$value": "{color.success.100}" },
    "warning-subtle": { "$value": "{color.warning.100}" }
  },

  "space": {
    "$type": "dimension",
    "0":   { "$value": "0px" },
    "0-5": { "$value": "2px" },
    "1":   { "$value": "4px" },
    "1-5": { "$value": "6px" },
    "2":   { "$value": "8px" },
    "3":   { "$value": "12px" },
    "4":   { "$value": "16px" },
    "6":   { "$value": "24px" },
    "8":   { "$value": "32px" },
    "12":  { "$value": "48px" },
    "16":  { "$value": "64px" }
  },
  "spacing": {
    "$type": "dimension",
    "inline": {
      "tight":   { "$value": "{space.1}", "$description": "Icon to label" },
      "default": { "$value": "{space.2}", "$description": "Between buttons and chips" }
    },
    "stack": {
      "tight":   { "$value": "{space.1-5}", "$description": "Label to input" },
      "default": { "$value": "{space.3}",   "$description": "Items in a list or form" },
      "section": { "$value": "{space.12}",  "$description": "Between page sections" }
    },
    "inset": {
      "compact": { "$value": "{space.3}", "$description": "Buttons, inputs, tags" },
      "card":    { "$value": "{space.6}", "$description": "Inside cards and widgets" }
    },
    "page": {
      "margin-mobile":  { "$value": "{space.4}" },
      "margin-desktop": { "$value": "{space.12}" }
    }
  },

  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "4px" },
    "md":   { "$value": "8px" },
    "lg":   { "$value": "16px" },
    "xl":   { "$value": "24px" },
    "full": { "$value": "9999px" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Söhne", "Inter", "system-ui", "sans-serif"], "$description": "Söhne requires a Klim web license" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400, "$description": "Söhne Buch" },
      "medium":   { "$value": 500, "$description": "Söhne Kräftig" },
      "semibold": { "$value": 600, "$description": "Söhne Halbfett" }
    }
  },
  "typography": {
    "$type": "typography",
    "heading": {
      "display": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.semibold}", "fontSize": "51px", "lineHeight": "68px" } },
      "xl":      { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.semibold}", "fontSize": "38px", "lineHeight": "52px" } },
      "lg":      { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.semibold}", "fontSize": "28px", "lineHeight": "38px" } },
      "md":      { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.semibold}", "fontSize": "21px", "lineHeight": "30px" } },
      "sm":      { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.semibold}", "fontSize": "16px", "lineHeight": "22px" } }
    },
    "body": {
      "lg": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.regular}", "fontSize": "21px", "lineHeight": "30px" } },
      "md": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.regular}", "fontSize": "16px", "lineHeight": "24px" } },
      "sm": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.regular}", "fontSize": "14px", "lineHeight": "24px" } }
    },
    "label": {
      "md": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.regular}", "fontSize": "16px", "lineHeight": "18px" } },
      "sm": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.regular}", "fontSize": "14px", "lineHeight": "16px" } },
      "xs": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.regular}", "fontSize": "12px", "lineHeight": "14px" } }
    },
    "caption": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.regular}", "fontSize": "12px", "lineHeight": "20px" } }
  },

  "elevation": {
    "$type": "shadow",
    "1": { "$value": { "color": "#00000014", "offsetX": "0px", "offsetY": "1px", "blur": "4px", "spread": "0px" }, "$description": "Cards" },
    "2": { "$value": { "color": "#00000026", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px" }, "$description": "Dropdowns, popovers" },
    "3": { "$value": { "color": "#00000040", "offsetX": "0px", "offsetY": "4px", "blur": "20px", "spread": "0px" }, "$description": "Modals" }
  }
}
